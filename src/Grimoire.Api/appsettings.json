{
  "ConnectionStrings": {
    "Default": "Data Source=grimoire.db"
  },
  "Management": {
    "AdminApiKey": "change-me"
  },
  "Encryption": {
    "MasterKey": "change-me-32-chars-minimum-key!!"
  },
  "Dashboard": {
    "ExpiringWithinDays": 14,
    "StaleAfterDays": 7,
    "CacheSeconds": 15
  },
  "ConsumerActivity": {
    "FlushIntervalSeconds": 60
  },
  "Audit": {
    "Enabled": true,
    "RetentionDays": 180,
    "QueueCapacity": 10000
  },
  "Backup": {
    "Enabled": false,
    "Key": "",
    "Schedule": "0 3 * * *",
    "TimeZone": "UTC",
    "RetentionCount": 14,
    "HealthcheckUrl": "",
    "VerifyHealthcheckUrl": "",
    "Local": {
      "Enabled": false,
      "Directory": ""
    },
    "S3": {
      "Enabled": false,
      "ServiceUrl": "",
      "Region": "",
      "Bucket": "",
      "Prefix": "grimoire/",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "LogStream": {
    "Enabled": true,
    "Server": "",
    "ApiKey": "",
    "ApiToken": "",
    "MinimumLevel": "Information",
    "Transport": "Udp",
    "UdpPort": 8082
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
