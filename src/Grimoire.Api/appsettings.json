{
  "ConnectionStrings": {
    "Default": "Data Source=grimoire.db"
  },
  "Management": {
    "AdminApiKey": "change-me"
  },
  "Encryption": {
    "MasterKey": "change-me-32-chars-minimum-key!!"
  },
  "Backup": {
    "Enabled": false,
    "Key": "",
    "Schedule": "0 3 * * *",
    "TimeZone": "UTC",
    "RetentionCount": 14,
    "HealthcheckUrl": "",
    "VerifyHealthcheckUrl": "",
    "Local": {
      "Enabled": false,
      "Directory": ""
    },
    "S3": {
      "Enabled": false,
      "ServiceUrl": "",
      "Region": "",
      "Bucket": "",
      "Prefix": "grimoire/",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "LogStream": {
    "Enabled": true,
    "Server": "",
    "ApiKey": "",
    "ApiToken": "",
    "MinimumLevel": "Information"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
