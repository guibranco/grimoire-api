<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>grimoire</AssemblyName>
    <RootNamespace>Grimoire.Cli</RootNamespace>
    <DefineConstants>$(DefineConstants);GRIMOIRE_CLI</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Label="dotnet tool">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>grimoire</ToolCommandName>
    <PackageId>Grimoire.Cli</PackageId>
    <Title>Grimoire CLI</Title>
    <Description>Command-line client for Grimoire, the self-hosted Vault &amp; Configuration Manager: read secrets, export configuration to .env or JSON, and run a process with its secrets injected as environment variables.</Description>
    <Authors>Guilherme Branco Stracini</Authors>
    <Company>Guilherme Branco Stracini ME</Company>
    <Copyright>© $([System.DateTime]::Now.Year) Guilherme Branco Stracini. All rights reserved.</Copyright>
    <PackageTags>grimoire;vault;secrets;configuration;cli;dotnet-tool;dotenv;self-hosted</PackageTags>
    <PackageProjectUrl>https://guibranco.github.io/grimoire-api/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/guibranco/grimoire-api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Label="Export formatting shared with Grimoire.Core">
    <Compile
      Include="../Grimoire.Core/Export/ExportFormatter.cs"
      Link="Export/ExportFormatter.cs"
    />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grimoire.Tests" />
    <InternalsVisibleTo Include="Grimoire.IntegrationTests" />
  </ItemGroup>
</Project>
