#!/bin/bash
# ForceCommand for the restricted deploy SSH user created by setup-server.sh.
# Usage (from CI):
#   ssh <deploy-user>@<host> <version> < release.tgz
#   ssh <deploy-user>@<host> configure-logstream < logstream.env
set -euo pipefail
COMMAND="${SSH_ORIGINAL_COMMAND:-}"
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+([-+.][0-9A-Za-z.-]+)?$'

if [[ "$COMMAND" == "configure-logstream" ]]; then
  exec sudo -n /usr/local/bin/grimoire-deploy --configure-logstream
fi
if [[ "$COMMAND" =~ $VERSION_RE ]]; then
  exec sudo -n /usr/local/bin/grimoire-deploy "$COMMAND"
fi

echo "usage: <version> < release.tgz | configure-logstream < logstream.env" >&2
exit 2
